  "deployment": {
    "workerVersionId": "5fe8c33c-85df-47ae-aa6c-6145a1260b7c",
    "date": "2026-09-08",
    "telemetryEnabled": true
  },
  "configuredAt": "2026-09-08",
  "alertConditions": [
    {
      "name": "Application failures",
      "windowMinutes": 5,
      "minimumFailures": 5,
      "failureRateAbove": 0.05,
      "excludeOperations": ["http.telemetry"],
      "categories": ["http", "rpc"]
    },
    {
      "name": "Board persistence or recovery invariant",
      "windowMinutes": 1,
      "operations": ["BoardObject.persist", "BoardObject.runMigrations", "mcp.recoverCommand"],
      "unexpectedFailuresAtLeast": 1
    },
    {
      "name": "Online acknowledgement timeouts",
      "windowMinutes": 10,
      "event": "acknowledgement_timeout",
      "minimumFailures": 5,
      "failureRateAbove": 0.05,
      "requires": ["online"]
    },
    {
      "name": "Stuck authorized edits",
      "windowMinutes": 10,
      "event": "outbox_observation",
      "pendingAgeSecondsAbove": 300,
      "consecutiveReports": 2,
      "requires": ["online", "canWrite"]
    },
    {
      "name": "Verified billing reconciliation failure",
      "windowMinutes": 1,
      "operation": "http.billingWebhook",
      "unexpectedFailuresAtLeast": 1
    },
    {
      "name": "Integration failures",
      "windowMinutes": 10,
      "category": "integration",
      "minimumFailures": 5,
      "failureRateAbove": 0.1
    },
    {
      "name": "Interactive latency",
      "windowMinutes": 10,
      "categories": ["http", "rpc"],
      "percentile": 95,
      "durationSecondsAbove": 2,
      "minimumOperations": 100,
      "excludeOperations": ["http.telemetry"]
    },
    {
      "name": "Browser regression",
      "windowMinutes": 15,
      "distinctReportingSessionsAtLeast": 3,
      "groupBy": ["clientRelease", "fingerprint"]
    }
  ],
  "plan": {
    "monitorLimit": 3,
    "strategy": "Group eight conditions into three monitors; preserve rule and operation in alert groups."
  },
  "validation": {
    "uniqueQueries": 47,
    "liveQueries": "pass",
    "syntheticThresholdQueries": "pass",
    "notificationTest": "Axiom trigger and recovery verified; inbox receipt unverified"
  },
  "console": {
    "url": "https://app.axiom.co",
    "dashboards": "Select the connected organization, open Dashboards, and search Sidequest.",
    "monitors": "Select the connected organization, open Monitors, and search Sidequest.",
    "directResourceLinks": "The connector does not expose the organization URL; resource UIDs and IDs are recorded above."
  }
}
