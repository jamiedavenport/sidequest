{
  "name": "sidequest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bun run cf-typegen && vite build",
    "cf-typegen": "wrangler types",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run",
    "dev": "bun run cf-typegen && vite dev",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "knip": "knip",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bun run cf-typegen && tsrx-tsc --noEmit && effect-language-service diagnostics --project tsconfig.json --strict"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@tsrx/react": "0.2.63",
    "@tsrx/vite-plugin-react": "0.0.96",
    "class-variance-authority": "0.7.1",
    "cnfast": "0.1.0",
    "effect": "4.0.0-rc.112",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@effect/language-service": "0.87.2",
    "@tailwindcss/vite": "4.3.3",
    "@tsrx/oxc": "0.7.0",
    "@tsrx/typescript-plugin": "0.3.128",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "knip": "6.33.0",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "packageManager": "bun@1.3.13"
}
