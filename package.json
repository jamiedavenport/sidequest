{
  "name": "sidequest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bun run cf-typegen && vite build",
    "cf-typegen": "wrangler types",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run",
    "dev": "bun run cf-typegen && vite dev",
    "format": "oxfmt --check src .github README.md .oxlintrc.json .oxfmtrc.json vite.config.ts vitest.config.ts package.json tsconfig.json wrangler.jsonc",
    "format:fix": "oxfmt --write src .github README.md .oxlintrc.json .oxfmtrc.json vite.config.ts vitest.config.ts package.json tsconfig.json wrangler.jsonc",
    "lint": "oxlint --type-aware --deny-warnings src vite.config.ts vitest.config.ts",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix src vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bun run cf-typegen && tsrx-tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@tsrx/react": "0.2.63",
    "@tsrx/vite-plugin-react": "0.0.96",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@tanstack/router-cli": "1.167.33",
    "@tsrx/oxc": "0.7.0",
    "@tsrx/typescript-plugin": "0.3.128",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "packageManager": "bun@1.3.13"
}
