{
  "$schema": "./node_modules/oxlint-current/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "ignorePatterns": ["src/routeTree.gen.ts", "worker-configuration.d.ts"],
  "plugins": ["eslint", "typescript", "react", "react-perf", "jsx-a11y", "unicorn"],
  "rules": {
    "eslint/curly": ["error", "all"],
    "react/react-in-jsx-scope": "off",
    "eslint/no-underscore-dangle": ["warn", { "allow": ["_tag"] }]
  },
  "overrides": [
    {
      "files": ["**/*.tsrx"],
      "rules": {
        "typescript/consistent-return": "off"
      }
    }
  ]
}
