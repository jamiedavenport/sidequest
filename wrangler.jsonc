{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sidequest",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD",
        "class_name": "BoardObject",
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sidequest-db",
      "database_id": "b61cbc63-2225-464d-9fe4-a992033a343c",
      "migrations_dir": "drizzle",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardObject"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "sdqst.app",
      "custom_domain": true,
    },
    {
      "pattern": "www.sdqst.app",
      "custom_domain": true,
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://sdqst.app",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY"],
  },
}
