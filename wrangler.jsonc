{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sidequest",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD",
        "class_name": "BoardObject",
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sidequest-db",
      "database_id": "b61cbc63-2225-464d-9fe4-a992033a343c",
      "migrations_dir": "drizzle",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardObject"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "sdqst.app",
      "custom_domain": true,
    },
    {
      "pattern": "www.sdqst.app",
      "custom_domain": true,
    },
  ],
  // Leave secrets.required unset so optional Polar secrets load from .dev.vars locally.
  "vars": {
    "BILLING_CHECKOUT_ENABLED": "false",
    "BILLING_ENFORCEMENT_ENABLED": "false",
    "POLAR_SERVER": "production",
    "POLAR_ORGANIZATION_ID": "e843bd42-20eb-451d-90b4-9bb9273ebce4",
    "POLAR_MONTHLY_PRODUCT_ID": "483c4e11-681b-4644-8fd0-4545293fdb5a",
    "POLAR_ANNUAL_PRODUCT_ID": "db6d66d5-536b-40fe-b539-46f074d669bf",
    "MCP_ALLOWED_ORIGINS": "",
    "BETTER_AUTH_URL": "https://sdqst.app",
  },
}
